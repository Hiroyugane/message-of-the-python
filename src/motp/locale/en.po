msgstr "terminal: tty {tty}, TERM {term}, encoding {encoding}, charset {charset}, colour level {colors}"

msgid "collect.log.crashed"
msgstr "collect: stopped by an unexpected error ({kind}); run motp collect --no-sandbox as root to see it"

msgid "install.error.source_writable"
msgstr "the archive can be changed by users other than its owner"

msgid "install.error.own_dir"
msgstr "{path} exists but is not a directory of root that only root can write"

msgid "install.error.busy"
msgstr "a collector run did not finish in time; try again"

msgid "install.waiting"
msgstr "waiting for the running collection to finish ({seconds} s)"

msgid "doctor.error.not_isolated"
msgstr "this Python runs without -I -S; run /opt/motp/bin/motp doctor"

msgid "doctor.error.link"
msgstr "{path} is a link"

# --- motp explain (explain.py) --------------------------------------------------------

msgid "cli.explain.help"
msgstr "explain a row or a warning of the message"

msgid "cli.explain.topic_help"
msgstr "the topic; without one, the topics are listed"

msgid "explain.unknown_topic"
msgstr "no topic named {topic}; motp explain lists the topics"

msgid "explain.list.heading"
msgstr "Topics (motp explain TOPIC):"

msgid "explain.heading.warn"
msgstr "Warnings"

msgid "explain.heading.todo"
msgstr "What to do"

msgid "explain.heading.commands"
msgstr "Commands the message suggests"

msgid "explain.limits"
msgstr "Limits here: warning from {warn}, critical from {crit} (setting thresholds.{rule})."

msgid "explain.hostname.title"
msgstr "Host name"

msgid "explain.hostname.what"
msgstr "The name this machine gives itself, as the kernel reports it. The large header shows the part before the first dot."

msgid "explain.os.title"
msgstr "Operating system"

msgid "explain.os.what"
msgstr "The distribution and release, read from /etc/os-release."

msgid "explain.kernel.title"
msgstr "Kernel"

msgid "explain.kernel.what"
msgstr "The version of the Linux kernel that is running now. After a kernel update the old one keeps running until the next restart (see reboot)."

msgid "explain.address.title"
msgstr "Local address"

msgid "explain.address.what"
msgstr "The addresses of this machine's own network interfaces, without loopback and link-local ones; at most four are shown. This is not the address the internet sees: MOTP contacts no outside service."

msgid "explain.dns.title"
msgstr "DNS servers"

msgid "explain.dns.what"
msgstr "The servers this machine asks to turn names into addresses, from systemd-resolved where it runs, else from /etc/resolv.conf."

msgid "explain.uptime.title"
msgstr "Uptime"

msgid "explain.uptime.what"
msgstr "The time since the machine started."

msgid "explain.load.title"
msgstr "Load"

msgid "explain.load.what"
msgstr "The load averages of the last 1, 5 and 15 minutes: how many processes were running or waiting. A load equal to the number of CPU cores means every core was busy."

msgid "explain.load.warn"
msgstr "The 5-minute value, divided by the number of cores, has reached a limit. Short peaks are normal during updates or builds."

msgid "explain.load.todo"
msgstr "Look for the process that uses the CPU or waits for the disk, for example with top or ps."

msgid "explain.memory.title"
msgstr "Memory"

msgid "explain.memory.what"
msgstr "The memory in use, out of all of it. Memory the kernel uses as a file cache and can free at once does not count as used."

msgid "explain.memory.warn"
msgstr "Little memory is left. The system may start to swap or to end processes."

msgid "explain.memory.todo"
msgstr "Find the largest processes, for example with top (press M), and stop or limit what is not needed."

msgid "explain.swap.title"
msgstr "Swap"

msgid "explain.swap.what"
msgstr "Space on a disk that holds memory pages when memory runs short. The row is shown only when the system has swap."

msgid "explain.swap.warn"
msgstr "Much of the swap is in use, a sign that memory has been short."

msgid "explain.swap.todo"
msgstr "See memory. Pages stay in swap until they are needed again, so the value can stay high after the shortage is over."

msgid "explain.updates.title"
msgstr "Updates"

msgid "explain.updates.what"
msgstr "Updates that are waiting to be installed, counted from the package lists this system downloaded; MOTP never refreshes them itself. Admins also see the package names. Rows below say how many packages are held back and, when the lists are older than seven days, their age."

msgid "explain.updates.warn"
msgstr "Security updates are pending, or this system cannot tell security updates from others, so any of them may be one. \"Unknown\" means no package lists were downloaded yet."

msgid "explain.updates.todo"
msgstr "Install the updates with the command below. Refresh old or missing lists first: sudo apt update on Debian and Ubuntu, sudo dnf makecache on Fedora and the RHEL family."

msgid "explain.reboot.title"
msgstr "Reboot"

msgid "explain.reboot.what"
msgstr "Whether updates wait for a restart: on Debian and Ubuntu by the file /run/reboot-required, on Fedora and the RHEL family when the kernel or a core library was installed after the system started. Admins see the packages."

msgid "explain.reboot.warn"
msgstr "A restart is needed. Until then the old versions keep running, with the faults the update fixes."

msgid "explain.reboot.todo"
msgstr "Restart when it suits the people and services that use the machine."

msgid "explain.eol.title"
msgstr "End of support"

msgid "explain.eol.what"
msgstr "The last day this release of the operating system gets security updates. It comes from the system itself (SUPPORT_END) or from a table that ships with MOTP; \"as of\" is the day that table was last checked."

msgid "explain.eol.warn"
msgstr "Support ends within 90 days, or it has ended. After the end new security holes in the system are no longer fixed."

msgid "explain.eol.todo"
msgstr "Back up your data and plan the upgrade to a newer release, following the distribution's guide. Some distributions sell or offer extended support."

msgid "explain.firewall.title"
msgstr "Firewall"

msgid "explain.firewall.what"
msgstr "Whether ufw, firewalld or nftables is active, judged by their systemd units and settings. Rules loaded in other ways, such as by a script or a container runtime, are not seen. Admins only."

msgid "explain.firewall.warn"
msgstr "No firewall is active, or one failed to start, which is critical. Without one, every service that listens on the network can be reached."

msgid "explain.firewall.todo"
msgstr "Turn a firewall on. Before that, allow SSH, or you can lock yourself out of a remote machine. If one failed, systemctl status and journalctl for its unit say why."

msgid "explain.autoupdates.title"
msgstr "Automatic updates"

msgid "explain.autoupdates.what"
msgstr "Whether updates are installed without anyone doing it: unattended-upgrades on Debian and Ubuntu, dnf-automatic on Fedora and the RHEL family. Downloading alone does not count. Admins only."

msgid "explain.autoupdates.warn"
msgstr "Automatic updates are off, not installed, or only download. \"APT::Periodic::Enable is 0\" means one line in /etc/apt/apt.conf.d switches the whole run off; \"Set apply_updates = yes\" means the timer runs but dnf is not told to install."

msgid "explain.autoupdates.todo"
msgstr "Use the command that stands with the warning. For APT::Periodic::Enable, remove the line the search finds. For apply_updates, set apply_updates = yes under [commands] in the file the command opens."

msgid "explain.logins.title"
msgstr "Failed logins"

msgid "explain.logins.what"
msgstr "How many login connections failed in the last 24 hours, from /var/log/btmp; several wrong passwords in one connection count once. \"More than\" means the count stopped at its limit. Admins see where most came from; user names are never read. Systems that no longer keep btmp, such as Debian 13, show \"not recorded on this system\"; the journal still lists failed logins (journalctl -u ssh)."

msgid "explain.logins.todo"
msgstr "On a machine reachable from the internet a steady stream of attempts is common. Log in to SSH with keys only and consider fail2ban."

msgid "explain.fail2ban.title"
msgstr "Fail2ban"

msgid "explain.fail2ban.what"
msgstr "How many addresses fail2ban blocks right now, over all its jails (sets of rules, one per service). Admins see jail names and addresses."

msgid "explain.fail2ban.warn"
msgstr "fail2ban is installed but its server is not running, so nothing gets blocked. \"Not checked\" means MOTP did not start fail2ban's client as root, because a directory its Python imports from can be changed by someone other than root; sudo motp doctor names it."

msgid "explain.fail2ban.todo"
msgstr "Start the service (sudo systemctl enable --now fail2ban). If it stops again, journalctl -u fail2ban says why."

msgid "explain.login.title"
msgstr "Last login"

msgid "explain.login.what"
msgstr "Your own previous login: when it was and, where known, the host and terminal it came from. It is shown at login only, and only to you."

msgid "explain.login.todo"
msgstr "If you do not recognise the time or the host, change your password and your SSH keys, and tell the admin."

msgid "explain.sessions.title"
msgstr "Sessions"

msgid "explain.sessions.what"
msgstr "How many terminal sessions are logged in now, as the command who counts them. Admins see who and from where. Systems without /run/utmp, such as Debian 13, show \"not recorded on this system\"; loginctl lists the sessions there."

msgid "explain.disks.title"
msgstr "Disk space"

msgid "explain.disks.what"
msgstr "How full each local file system is, counted like df. Network and temporary file systems are left out. Removable media and per-user mounts are for admins only."

msgid "explain.disks.warn"
msgstr "A file system is nearly full. When it is full, programs fail to write: logs, databases and updates first."

msgid "explain.disks.todo"
msgstr "Find what takes the space, for example with sudo du -xh --max-depth=1 on the mount point, and delete or move what is not needed."

msgid "explain.inodes.title"
msgstr "Inodes"

msgid "explain.inodes.what"
msgstr "Each file and directory needs one inode, and some file systems have a fixed number of them. The row appears once half of them are in use."

msgid "explain.inodes.warn"
msgstr "The inodes run out. Then no new file can be made, even though there is free space."

msgid "explain.inodes.todo"
msgstr "Look for directories with very many small files, such as mail queues, caches or sessions, and clean them up."

msgid "explain.units.title"
msgstr "Failed units"

msgid "explain.units.what"
msgstr "systemd units (services, mounts, timers and so on) in the state failed. The number is public, the names are for admins."

msgid "explain.units.warn"
msgstr "At least one unit failed: something that should run or have finished did not."

msgid "explain.units.todo"
msgstr "List them, read journalctl -u NAME for each, fix the cause and restart the unit. sudo systemctl reset-failed clears the state of one that no longer matters."

msgid "explain.services.title"
msgstr "Watched units"

msgid "explain.services.what"
msgstr "Rows the admin set up with [[rows.unit]] in the configuration, one per systemd unit. The value is the state systemd reports, in systemd's own words."

msgid "explain.services.warn"
msgstr "The unit is not active: failed is critical; inactive, activating, deactivating, maintenance, not found or masked is a warning. reloading and refreshing count as active. \"State unknown\" means systemd gave no answer MOTP understands."

msgid "explain.services.todo"
msgstr "systemctl status NAME shows what is wrong. For a unit that is not found, check its name in the configuration."

msgid "explain.files.title"
msgstr "Watched files"

msgid "explain.files.what"
msgstr "Rows the admin set up with [[rows.file_age]]: how long ago a file last changed, for example the stamp a backup writes when it succeeded."

msgid "explain.files.warn"
msgstr "The file is older than warn_after or crit_after, or it is missing. \"Unreadable\" means the user motp may not look at it."

msgid "explain.files.todo"
msgstr "Check the job that should update the file. For a file motp may not read, grant access or use a plugin that runs as root (docs/plugins.md)."

msgid "explain.containers.title"
msgstr "Containers"

msgid "explain.containers.what"
msgstr "Containers of Docker, and of Podman where podman.socket is enabled, counted by state. Admins see names and images."

msgid "explain.containers.warn"
msgstr "A container is unhealthy or keeps restarting, or the runtime did not answer. \"Service stopped\" means Docker is not running; MOTP does not start it."

msgid "explain.containers.todo"
msgstr "docker ps -a lists the containers (podman ps -a for Podman); docker logs NAME shows what one printed."

msgid "explain.plugins.title"
msgstr "Plugins"

msgid "explain.plugins.what"
msgstr "Rows from programs the admin put into /etc/motp/plugins.d. Each starts with [plugin NAME]. Their text comes from the plugin, not from MOTP, and a hint of theirs is only text, never a command MOTP vouches for."

msgid "explain.plugins.todo"
msgstr "motp doctor, run as root, lists each plugin, whether it may run and how its last run went. docs/plugins.md describes how to write one."

msgid "explain.collector.title"
msgstr "Collected data and modules"

msgid "explain.collector.what"
msgstr "A timer runs the collector, which gathers most values ahead of time; at login MOTP only reads them. Uptime, load and memory are read live."

msgid "explain.collector.warn"
msgstr "\"The collected data is old\": the collector has not written for three of its periods. \"No collected data\": it has not run yet, or its files cannot be read. \"Module failed\": a part could not be collected; its last values may still be shown. \"Config: 1 file ignored\" (admins only): a config file has a mistake, so the collector uses the defaults and the other files; sudo motp config check names the file, line and setting."

msgid "explain.collector.todo"
msgstr "Run motp doctor (as root for all details) and check the timer with the command below."

msgid "explain.status.title"
msgstr "Warnings and markers"

msgid "explain.status.what"
msgstr "Values are coloured by status: ok, warning or critical. Without colour a warning is marked [!] and a critical value [!!]. The block at the top collects them, worst first, with a command where one helps."

msgid "explain.status.warn"
msgstr "An age in brackets, such as (45 minutes old), means the value was not refreshed lately. \"Unknown\" means MOTP has no value it can trust, for example because the data is too old."

msgid "explain.status.todo"
msgstr "motp explain TOPIC explains a single row. The limits for warnings can be changed under [thresholds] in /etc/motp/config.toml."

# --- tips (core/tips.py) --------------------------------------------------------------

msgid "tip.explain"
msgstr "motp explain TOPIC says what a row or a warning means."

msgid "tip.doctor"
msgstr "motp doctor checks the installation and says what is wrong."

msgid "tip.modules"
msgstr "motp modules shows which modules run, and why others do not."

msgid "tip.preview"
msgstr "motp preview --demo shows the message with example data."

msgid "tip.plugins"
msgstr "A small program in /etc/motp/plugins.d adds rows of your own."

msgid "tip.unit_rows"
msgstr "A [[rows.unit]] entry in the configuration watches a service."

msgid "tip.file_rows"
msgstr "A [[rows.file_age]] entry warns when your last backup gets old."

msgid "tip.config_check"
msgstr "After editing /etc/motp, run sudo motp config check."

msgid "tip.no_color"
msgstr "Set NO_COLOR=1 in your environment to see MOTP without colour."

msgid "tip.shell_init"
msgstr "motp shell-init bash prints the lines that add MOTP to new terminals."

msgid "tip.classic"
msgstr "preset = \"classic\" under [theme] brings back the look of 2019."

msgid "tip.off"
msgstr "These tips are switched by tips under [layout] in the configuration."
