msgstr "{key} must be exactly one printable character, one cell wide"

msgid "config.error.char_ascii"
msgstr "{key} must be exactly one printable ASCII character"

msgid "config.error.bar_chars"
msgstr "{key}: bar_used and bar_free must differ, so the used and the free part of a meter can be told apart"

msgid "config.error.font_name"
msgstr "{key} must be \"auto\", a bundled font (motp-block, motp-block-small, big, small) or the name of a file in /etc/motp/fonts/ without \".flf\""

msgid "config.error.font_charset"
msgstr "{key}: motp-block and motp-block-small draw block characters for Unicode terminals; use big, small or a font of ASCII characters"

msgid "config.error.font_file"
msgstr "{key}: this font is not used. Expected a FIGfont file of at most {max} KiB that belongs to root and is not writable by group or others"

msgid "config.error.font_format"
msgstr "{key}: this font is not used. Expected a FIGfont file whose characters are printable and one cell wide, at most 16 rows of 64 cells"

msgid "config.error.font_ascii"
msgstr "{key}: this font is not used. The ASCII header needs a font drawn with ASCII characters only"

msgid "config.error.item_keys"
msgstr "{key} must be a list of at most {max} item keys such as \"os_host.kernel\" (see motp modules --keys)"

msgid "proc.error.account"
msgstr "{name} must be a local system account with its own user id and a group other than root"

