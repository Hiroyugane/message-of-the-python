msgid "config.error.font_charset"
msgstr "{key}: motp-block und motp-block-small zeichnen Blockzeichen für Unicode-Terminals; big, small oder eine Schrift aus ASCII-Zeichen verwenden"

msgid "config.error.font_file"
msgstr "{key}: diese Schrift wird nicht verwendet. Erwartet wird eine FIGfont-Datei bis {max} KiB, die root gehört und für Gruppe und andere nicht schreibbar ist"

msgid "config.error.font_format"
msgstr "{key}: diese Schrift wird nicht verwendet. Erwartet wird eine FIGfont-Datei mit druckbaren, eine Zelle breiten Zeichen, höchstens 16 Zeilen zu 64 Zellen"

msgid "config.error.font_ascii"
msgstr "{key}: diese Schrift wird nicht verwendet. Die ASCII-Kopfzeile braucht eine Schrift, die nur aus ASCII-Zeichen besteht"

msgid "config.error.item_keys"
msgstr "{key} muss eine Liste von höchstens {max} Eintragsschlüsseln wie \"os_host.kernel\" sein (siehe motp modules --keys)"

