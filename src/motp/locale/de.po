# German message catalogue of MOTP, the message of the python.
# Ids and order follow en.po. Style: plain German as an administrator writes it, the
# infinitive instead of "Sie" or "du", and one word per thing (see docs/languages.md).
# Commands, file names and setting names stay as they are.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

